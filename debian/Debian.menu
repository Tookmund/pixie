LABEL install1364
	MENU LABEL Install Debian 13 amd64
	KERNEL ::/debian/13/amd64/linux
	APPEND vga=788 initrd=::/debian/13/amd64/initrd.gz

LABEL install1064
	MENU LABEL Install Debian 10 amd64
	KERNEL ::/debian/10/amd64/linux
	APPEND vga=788 initrd=::/debian/10/amd64/initrd.gz

LABEL install1032
	MENU LABEL Install Debian 10 i386
	KERNEL ::/debian/10/i386/linux
	APPEND vga=788 initrd=::/debian/10/i386/initrd.gz
